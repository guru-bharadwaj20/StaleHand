{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VivianSobers/StaleHand/schema/scenario.schema.json",
  "title": "Scenario",
  "description": "One task, the items on the first screen, and changes scheduled at later executor steps.",
  "type": "object",
  "required": ["id", "domain", "seed", "task", "criterion", "items", "changes", "meta"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]+-[a-z_]+-[0-9]{3}-[A-Za-z0-9_]+$"},
    "domain": {"type": "string"},
    "seed": {"type": "integer"},
    "task": {"type": "string", "minLength": 1},
    "criterion": {"$ref": "#/$defs/criterion"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "change"],
        "additionalProperties": false,
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "change": {"$ref": "#/$defs/change"}
        }
      }
    },
    "meta": {"type": "object"},
    "derived": {
      "type": "object",
      "required": ["stale_target", "final_target", "change_kind"],
      "additionalProperties": false,
      "properties": {
        "stale_target": {"type": "string"},
        "final_target": {"type": ["string", "null"]},
        "change_kind": {"enum": ["none", "irrelevant", "relevant", "target_removed"]}
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "attrs"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "attrs": {"type": "object"}
      }
    },
    "criterion": {
      "type": "object",
      "required": ["filters", "order"],
      "additionalProperties": false,
      "properties": {
        "filters": {
          "type": "array",
          "items": {"type": "array", "prefixItems": [{"type": "string"}, {}], "minItems": 2, "maxItems": 2}
        },
        "order": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["field", "descending"],
              "additionalProperties": false,
              "properties": {"field": {"type": "string"}, "descending": {"type": "boolean"}}
            }
          ]
        }
      }
    },
    "change": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "items", "position"], "additionalProperties": false,
          "properties": {"type": {"const": "insert"}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
                         "position": {"type": "integer", "minimum": 0}}
        },
        {
          "type": "object", "required": ["type", "ids"], "additionalProperties": false,
          "properties": {"type": {"const": "remove"}, "ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
        },
        {
          "type": "object", "required": ["type", "id", "attrs"], "additionalProperties": false,
          "properties": {"type": {"const": "update"}, "id": {"type": "string"}, "attrs": {"type": "object"}}
        },
        {
          "type": "object", "required": ["type", "field", "descending"], "additionalProperties": false,
          "properties": {"type": {"const": "sort"}, "field": {"type": "string"}, "descending": {"type": "boolean"}}
        },
        {
          "type": "object", "required": ["type", "label"], "additionalProperties": false,
          "properties": {"type": {"const": "cosmetic"}, "label": {"type": "string"}}
        }
      ]
    }
  }
}
