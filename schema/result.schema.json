{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VivianSobers/StaleHand/schema/result.schema.json",
  "title": "EpisodeResult",
  "description": "One scored episode, as written by stalehand.metrics.outcome.score. Reports and statistics read only these rows.",
  "type": "object",
  "required": ["scenario_id", "guard", "architecture", "kind", "variant", "change_kind", "outcome", "target",
               "correct_target", "stale_target", "end_reason", "fired", "false_alarm", "planner_calls",
               "executor_calls", "checker_calls", "model_seconds", "env_steps", "parse_failures", "commit_step",
               "commit_before_change"],
  "properties": {
    "scenario_id": {"type": "string"},
    "guard": {"type": "string"},
    "architecture": {"enum": ["hierarchical", "delegated", "flat"]},
    "kind": {"type": ["string", "null"]},
    "variant": {"type": ["string", "null"]},
    "change_kind": {"enum": ["none", "irrelevant", "relevant", "target_removed"]},
    "outcome": {"enum": ["success", "stale", "wrong_item", "wrong_detail", "aborted", "no_commit"]},
    "target": {"type": ["string", "null"]},
    "correct_target": {"type": ["string", "null"]},
    "stale_target": {"type": "string"},
    "end_reason": {"type": ["string", "null"]},
    "fired": {"type": "integer", "minimum": 0},
    "false_alarm": {"type": "boolean"},
    "planner_calls": {"type": "integer", "minimum": 0},
    "executor_calls": {"type": "integer", "minimum": 0},
    "checker_calls": {"type": "integer", "minimum": 0},
    "model_seconds": {"type": "number", "minimum": 0},
    "env_steps": {"type": "integer", "minimum": 0},
    "parse_failures": {"type": "integer", "minimum": 0},
    "commit_step": {"type": ["integer", "null"]},
    "commit_before_change": {"type": "boolean"},
    "run": {"type": "object", "description": "Run provenance added by the runner: job id, models, seed, versions."}
  }
}
